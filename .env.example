# ======================================================================
# MoshouSapient - 環境變數設定檔範本
# ======================================================================
# 說明:
# 1. 請將此檔案複製一份並重新命名為 .env
# 2. 根據您的實際環境，修改 .env 檔案中的設定值。
# 3. .env 檔案已被 .gitignore 忽略，不會被提交到版本控制中，請放心填寫敏感資訊。
# 4. 如果您想使用系統預設值，可以將對應的行註解掉或直接刪除。
# ======================================================================

# --- [必要] 系統運行模式設定 ---
# 系統的主要運行模式。
# - "RTSP": 啟用即時攝影機監控模式。
# - 任何其他值 (或將此行註解掉): 系統將進入閒置模式，僅運行背景服務 (如檔案攝取)。
# 預設值: "RTSP"
VIDEO_SOURCE_TYPE="RTSP"

# 【RTSP 模式專用】攝影機的 RTSP 串流網址。
# 範例: "rtsp://admin:password@192.168.1.100:554/stream1"
RTSP_URL=""

# 【RTSP 模式專用】RTSP 的傳輸協定。
# 對於大多數低延遲場景，UDP 是更好的選擇。如果網路不穩定，可嘗試 TCP。
# 可選值: "UDP", "TCP"
# 預設值: "UDP"
RTSP_TRANSPORT_PROTOCOL="UDP"

# --- [可選] 事件影片設定 ---
# 事件發生前，需要額外錄製的秒數。
# 預設值: 1.0
PRE_EVENT_SECONDS=1.0

# 事件完全消失後，需要額外錄製的秒數。
# 預設值: 3.0
POST_EVENT_SECONDS=3.0

# 一個事件結束後，進入下一個事件的冷卻時間 (秒)。
# 預設值: 5.0
COOLDOWN_PERIOD=5.0

# 單個事件影片片段的最大時長 (秒)。
# 超過此時長的連續事件將被自動切分為多個影片。
# 預設值: 10.0
MAX_EVENT_DURATION=10.0

# --- [可選] 影片輸出設定 ---
# 輸出影片的幀率模式。
# - "SOURCE": 輸出幀率與來源幀率保持一致。
# - "TARGET": 輸出幀率將被轉換為下面設定的 TARGET_FPS。
# 可選值: "SOURCE", "TARGET"
# 預設值: "SOURCE"
VIDEO_FPS_MODE="SOURCE"

# 在 VIDEO_FPS_MODE 為 "TARGET" 時的目標幀率。
# 預設值: 30.0
TARGET_FPS=24.0

# 輸出影片的編碼模式。
# - "BALANCED": (推薦) 平衡模式，使用固定的目標位元率，畫質穩定。
# - "QUALITY": 品質優先模式，使用可變位元率，畫質更好但檔案大小可能波動。
# 可選值: "BALANCED", "QUALITY"
# 預設值: "BALANCED"
VIDEO_ENCODING_MODE="BALANCED"

# 在 VIDEO_ENCODING_MODE 為 "BALANCED" 時的目標平均位元率 (Mbps)。
# 預設值: 2.0
TARGET_BITRATE_MBPS=2.0

# --- [可選] Discord Bot 通知設定 ---
# 是否啟用 Discord 通知功能。
# 可選值: True / False
# 預設值: False
DISCORD_ENABLED=False

# 【若啟用 Discord】您的 Discord Bot Token。
DISCORD_TOKEN="YourDiscordBotTokenHere"

# 【若啟用 Discord】希望接收通知的 Discord 頻道 ID。
DISCORD_CHANNEL_ID="YourChannelIDHere"

# --- [可選] 系統效能設定 ---
# 背景影片處理程序 (Consumer) 的數量。
# [!!] 參數教學:
#   - 建議值: 根據您的 CPU 核心數和 GPU 編碼能力設定。
#   - 對於消費級 NVIDIA GPU (如 RTX 30/40 系列)，通常可以同時處理 2-4 個硬體編碼會話。
#   - 如果您發現影片生成速度跟不上事件發生速度，可以適當增加此數值。
# 預設值: 2
VIDEO_PROCESSING_WORKERS=2

# --- [可選] 系統日誌設定 ---
# 應用程式在主控台的日誌輸出詳細程度。
# [!!] 參數教學:
#   - "INFO": (預設值) 適用於正常運行。只顯示關鍵的系統狀態、事件和警告。
#   - "DEBUG": 適用於開發和除錯。會額外輸出非常詳細的初始化過程、內部狀態等資訊。
# 可選值: "INFO", "DEBUG"
# 預設值: "INFO"
LOG_LEVEL="INFO"

# --- [可選] 檔案攝取服務設定 ---
# 是否啟用「監控資料夾」功能。
# 啟用後，系統會自動處理放入 INGESTION_WATCH_DIR 目錄下的影片檔案。
# 可選值: True / False
# 預設值: False
INGESTION_ENABLED=False

# 【若啟用攝取服務】需要被監控的資料夾路徑 (相對於專案根目錄)。
# 預設值: "data/uploads"
INGESTION_WATCH_DIR="data/uploads"

# --- [可選] 智慧排程器設定 ---
# 是否啟用智慧排程器來處理背景檔案分析任務。
# 必須與 INGESTION_ENABLED=True 配合使用。
# 可選值: True / False
# 預設值: True
SCHEDULER_ENABLED=True

# 排程器檢查系統狀態的間隔時間 (秒)。
# 預設值: 15
SCHEDULER_CHECK_INTERVAL=15